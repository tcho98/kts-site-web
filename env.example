# --- Configuration SMTP (Brevo) pour l'envoi d'emails du formulaire de contact ---
# À récupérer dans ton compte Brevo : Menu > SMTP & API > SMTP
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USER=ton-identifiant-smtp-brevo
EMAIL_PASS=ta-cle-smtp-brevo

# Adresse d'expédition (doit être une adresse validée/vérifiée dans Brevo)
EMAIL_FROM=no-reply@ktsmobility.com

# Adresse qui reçoit les messages du formulaire de contact
CONTACT_TO_EMAIL=contact@ktsmobility.com
